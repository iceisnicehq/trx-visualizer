# This file belongs only to Flow. No mixer address or mixer secrets are used.
# Copy the server verifier from your private flow-atlas-admin.txt.
# Create a new verifier locally with: node scripts/create-admin.mjs
FLOW_PUBLISH_AUTH=

# Vercel only: connect a PRIVATE Blob store to this Flow Vercel project.
# Vercel supplies this token; leave it empty for Node/Docker or native Workers.
BLOB_READ_WRITE_TOKEN=

# Standalone Node/Docker only: persistent storage owned by this Flow instance.
PORT=8090
FLOW_LISTEN_HOST=127.0.0.1
FLOW_DATA_DIR=.data
FLOW_WEB_BIND_HOST=127.0.0.1
FLOW_WEB_PORT=8090
# Behind a reverse proxy, use THIS Flow website’s own public origin.
# FLOW_PUBLIC_ORIGIN=https://your-flow.example
