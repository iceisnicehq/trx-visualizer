# Server-only PBKDF2 verifier. Create one with npm run create-admin.
# Never put the actual password, this verifier or wallet keys in public/.
FLOW_PUBLISH_AUTH=
# Optional local Node server configuration:
PORT=8090
FLOW_DATA_DIR=.data
# Set this to your HTTPS origin when using a reverse proxy for the local server.
# FLOW_PUBLIC_ORIGIN=https://atlas.example.com
# Optional Vercel mirror; points to the protected public Flow Atlas API.
FLOW_API_ORIGIN=https://trx-flow-atlas-oct25.purple-rose-4948.chatgpt.site
