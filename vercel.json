{
  "framework": null,
  "buildCommand": "npm run build:static",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "functions": {
    "api/status.js": {
      "includeFiles": "public/dataset.json",
      "maxDuration": 60
    },
    "api/snapshot.js": {
      "includeFiles": "public/dataset.json",
      "maxDuration": 60
    },
    "api/admin/publish.js": {
      "includeFiles": "public/dataset.json",
      "maxDuration": 60
    }
  }
}
